set(deps_default "${PROJECT_SOURCE_DIR}/.dependencies")
if(DEFINED ENV{RAYNMEA_DEPS_ROOT} AND NOT "$ENV{RAYNMEA_DEPS_ROOT}" STREQUAL "")
    set(deps_default "$ENV{RAYNMEA_DEPS_ROOT}")
endif()
set(DEPS_ROOT "${deps_default}" CACHE PATH "Existing pinned dependency stage; defaults to RAYNMEA_DEPS_ROOT or clone-local .dependencies")
foreach(pair NMEA2000 NMEA0183 SOCKETCAN)
    if(pair STREQUAL "SOCKETCAN")
        set(folder NMEA2000_socketCAN)
    else()
        set(folder ${pair})
    endif()
    set(${pair}_ROOT "" CACHE PATH "Optional individual ${folder} checkout override")
    if(NOT ${pair}_ROOT)
        set(${pair}_ROOT "${DEPS_ROOT}/${folder}")
    endif()
endforeach()
set(verify_command "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/scripts/dependencies.py" verify --nmea2000 "${NMEA2000_ROOT}" --nmea0183 "${NMEA0183_ROOT}" --socketcan "${SOCKETCAN_ROOT}")
set(marine_sources
    "${NMEA0183_ROOT}/NMEA0183.cpp" "${NMEA0183_ROOT}/NMEA0183LinuxStream.cpp"
    "${NMEA0183_ROOT}/NMEA0183Messages.cpp" "${NMEA0183_ROOT}/NMEA0183Msg.cpp" "${NMEA0183_ROOT}/NMEA0183Stream.cpp")
foreach(file ActisenseReader N2kDeviceList N2kGroupFunction N2kGroupFunctionDefaultHandlers N2kMaretron N2kMessages N2kMsg N2kStream N2kTimer NMEA2000 Seasmart)
    list(APPEND marine_sources "${NMEA2000_ROOT}/src/${file}.cpp")
endforeach()
if(WIN32)
    list(APPEND marine_sources "${PROJECT_SOURCE_DIR}/src/windows_millis.cpp")
    set(SDL2_ROOT "${DEPS_ROOT}/SDL2-2.30.9/x86_64-w64-mingw32" CACHE PATH "Existing SDL2 MinGW SDK")
    set(SDL2_ARCHIVE "" CACHE FILEPATH "Pinned SDL2 archive for complete SDK integrity verification")
    if(NOT SDL2_ARCHIVE AND (EXISTS "${DEPS_ROOT}/.raynmea-sdl2-stage" OR EXISTS "${DEPS_ROOT}/.downloads/SDL2-devel-2.30.9-mingw.tar.gz"))
        set(SDL2_ARCHIVE "${DEPS_ROOT}/.downloads/SDL2-devel-2.30.9-mingw.tar.gz" CACHE FILEPATH "Pinned SDL2 archive for complete SDK integrity verification" FORCE)
    endif()
    if(SDL2_ARCHIVE)
        list(APPEND verify_command --sdl2-root "${SDL2_ROOT}" --sdl2-archive "${SDL2_ARCHIVE}")
    endif()
    add_library(raynmea_sdl INTERFACE)
    target_link_libraries(raynmea_sdl INTERFACE SDL2::SDL2)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    list(APPEND marine_sources "${PROJECT_SOURCE_DIR}/src/macos_millis.cpp")
    set(SDL2_ROOT "${DEPS_ROOT}/sdl2-macos-arm64/install" CACHE PATH "Verified native SDL2 stage")
    set(verify_sdl_command "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/scripts/sdl2-macos.py" verify --root "${SDL2_ROOT}/..")
    execute_process(COMMAND ${verify_sdl_command} RESULT_VARIABLE sdl_verify_result)
    if(NOT sdl_verify_result EQUAL 0)
        message(FATAL_ERROR "Native SDL2 verification failed; explicitly provision with scripts/sdl2-macos.py acquire; no automatic acquisition")
    endif()
    add_custom_target(raynmea_verify_sdl2 COMMAND ${verify_sdl_command} VERBATIM)
    find_package(SDL2 2.30.9 EXACT CONFIG REQUIRED PATHS "${SDL2_ROOT}/lib/cmake/SDL2" NO_DEFAULT_PATH)
    get_target_property(native_sdl_library SDL2::SDL2-static IMPORTED_LOCATION_RELEASE)
    file(REAL_PATH "${native_sdl_library}" native_sdl_library)
    file(REAL_PATH "${SDL2_ROOT}/lib/libSDL2.a" verified_sdl_library)
    if(NOT native_sdl_library STREQUAL verified_sdl_library)
        message(FATAL_ERROR "SDL2 package must link the verified native stage; inspect cached SDL2_DIR")
    endif()
    add_library(raynmea_sdl INTERFACE)
    target_link_libraries(raynmea_sdl INTERFACE SDL2::SDL2-static)
    add_dependencies(raynmea_sdl raynmea_verify_sdl2)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    list(APPEND marine_sources "${SOCKETCAN_ROOT}/NMEA2000_SocketCAN.cpp")
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(SDL2 REQUIRED IMPORTED_TARGET sdl2)
    add_library(raynmea_sdl INTERFACE)
    target_link_libraries(raynmea_sdl INTERFACE PkgConfig::SDL2)
endif()
execute_process(COMMAND ${verify_command} RESULT_VARIABLE verify_result)
if(NOT verify_result EQUAL 0)
    message(FATAL_ERROR "Dependency verification failed; provision explicitly with scripts/dependencies.py acquire (Windows: add --with-sdl2), or inspect configured roots; no automatic acquisition")
endif()
add_custom_target(raynmea_verify_dependencies COMMAND ${verify_command} VERBATIM)
if(WIN32)
    find_package(SDL2 2.30.9 EXACT CONFIG REQUIRED PATHS "${SDL2_ROOT}/lib/cmake/SDL2" NO_DEFAULT_PATH)
endif()
add_library(raynmea_marine STATIC ${marine_sources})
set_target_properties(raynmea_marine PROPERTIES AUTOMOC OFF AUTOUIC OFF)
target_include_directories(raynmea_marine PUBLIC "${NMEA2000_ROOT}/src" "${NMEA0183_ROOT}")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_include_directories(raynmea_marine PUBLIC "${SOCKETCAN_ROOT}")
endif()
add_dependencies(raynmea_marine raynmea_verify_dependencies)
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    # The pinned source recognizes desktop printf on Linux/Windows, but not
    # Darwin. Compile a checked generated copy; never alter the verified stage
    # or its approved patch. Darwin libc supports the same snprintf path.
    set(nmea0183_message_source "${NMEA0183_ROOT}/NMEA0183Msg.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${nmea0183_message_source}")
    file(READ "${nmea0183_message_source}" nmea0183_message)
    set(printf_guard "defined(linux)||defined(_WIN32)")
    string(REGEX MATCHALL "defined\\(linux\\)\\|\\|defined\\(_WIN32\\)" printf_guards "${nmea0183_message}")
    list(LENGTH printf_guards printf_guard_count)
    if(NOT printf_guard_count EQUAL 1)
        message(FATAL_ERROR "Pinned NMEA0183 desktop printf guard changed; review macOS adaptation")
    endif()
    string(REPLACE "${printf_guard}" "${printf_guard}||defined(__APPLE__)" nmea0183_message "${nmea0183_message}")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/marine-macos")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/marine-macos/NMEA0183Msg.cpp" "${nmea0183_message}")
    get_target_property(native_marine_sources raynmea_marine SOURCES)
    list(REMOVE_ITEM native_marine_sources "${nmea0183_message_source}")
    list(APPEND native_marine_sources "${CMAKE_CURRENT_BINARY_DIR}/marine-macos/NMEA0183Msg.cpp")
    set_property(TARGET raynmea_marine PROPERTY SOURCES "${native_marine_sources}")
endif()
